# SmartAama backend configuration — copy to backend/.env and fill in.
# Every variable read by app/core/config.py is listed here. Values below are placeholders.

# dev | staging | prod. Enables dev-only features (bootstrap endpoint, AUTO_INIT_DB) when "dev".
ENV=dev

# JWT signing secret. REQUIRED, at least 32 characters. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters

# JWT algorithm and access-token lifetime (minutes, 5..10080). Access tokens are stateless and
# cannot be revoked individually, so keep them short; clients renew them with the refresh token.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh-token lifetime (days, 1..365). Refresh tokens are stored server-side (hashed), rotated
# on every POST /api/v1/auth/refresh and revoked on logout / admin reject / soft-delete / role change.
REFRESH_TOKEN_EXPIRE_DAYS=14

# SQLAlchemy database URL. REQUIRED. PostgreSQL in production; SQLite works for quick local runs/tests.
DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@localhost:5432/smartaama
# DATABASE_URL=sqlite:///./smartaama_dev.db

# Dev only: when ENV=dev and AUTO_INIT_DB=true the app runs init_db() on startup (brings the
# schema to the Alembic head, seeds facilities, purges stale advisory analyses).
# Otherwise run:  python -m app.db.init_db   (or: alembic upgrade head)
AUTO_INIT_DB=false

# Dev only: shared secret for POST /api/v1/auth/bootstrap-admin (header X-Bootstrap-Token).
# Leave EMPTY to disable the endpoint entirely. Never set in production.
BOOTSTRAP_TOKEN=

# Comma-separated list of allowed browser origins (React dev server by default).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Private uploads root (ID cards are stored in <UPLOADS_DIR>/id_cards). Default: backend/uploads.
# UPLOADS_DIR=/var/lib/smartaama/uploads

# Max size of the ID-card image accepted by /auth/register (MB).
MAX_ID_CARD_SIZE_MB=5

# Sliding-window rate limit for /auth/login, /auth/register and /auth/refresh (per client IP).
# The hit log lives in the database (table auth_rate_limit_hits), so the limit is shared by every
# worker/process using the same database. RATE_LIMIT_DISABLED=true switches it off (tests only).
RATE_LIMIT_DISABLED=false
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Not read by the app; used only by `python -m app.scripts.create_super_admin` ---
# SUPER_ADMIN_USERNAME=<username>
# SUPER_ADMIN_EMAIL=<email>
# SUPER_ADMIN_PASSWORD=<at least 10 characters>
# SUPER_ADMIN_FULL_NAME=<optional display name>
# SUPER_ADMIN_FACILITY_NAME=<optional facility name, e.g. Bir Hospital>
# SUPER_ADMIN_FACILITY_TYPE=<optional: phc | hospital>
